{
  "name": "autoscale-cloud-portal",
  "version": "1.0.0",
  "private": true,
  "description": "DevOps automation and cloud autoscaling portal",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/sample-app",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace=apps/frontend && npm run build --workspace=apps/backend",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "recharts": "^3.10.1"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}

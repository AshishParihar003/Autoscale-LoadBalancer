# Node server
PORT=4000

# Absolute path to the Terraform project directory.
# Windows example: TERRAFORM_PROJECT_DIR=D:\\path\\to\\your\\terraform
# Leave unset to use ./infrastructure/terraform from the app directory.
TERRAFORM_PROJECT_DIR=

# Optional custom Terraform executable path; default is "terraform"
TERRAFORM_BIN=terraform

# Terraform variable passed by the instance-count control (default: vm_count)
TERRAFORM_INSTANCE_VARIABLE=vm_count

# Required to enable the explicit approve/apply endpoint. Use a long random secret.
# Without this value, plans can be generated but apply is disabled.
ADMIN_TOKEN=

# Terraform CLI command timeout in milliseconds
TERRAFORM_COMMAND_TIMEOUT_MS=120000
